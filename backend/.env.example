# =====================================================================
# RecoMind AI — Environment Configuration Template
# All API keys are OPTIONAL. The platform automatically uses keyless
# public registries & built-in web discovery when keys are omitted.
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI QUERY UNDERSTANDING (100% FREE)
# ---------------------------------------------------------------------
# Groq gives free access to fast LLM models with ultra-fast inference.
# Get free key here (No credit card required): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# 2. WEB SEARCH ALTERNATIVES (FREE OPTIONS)
# ---------------------------------------------------------------------
# OPTION A (RECOMMENDED): Tavily AI Search
# 1,000 searches/month 100% FREE. Built specifically for AI discovery.
# Get free key here (No credit card required): https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# OPTION B: Brave Search API (Paid / 2,000 free queries on trial)
# Leave blank if you don't want to use Brave; system auto-uses DuckDuckGo/Tavily.
BRAVE_API_KEY=

# ---------------------------------------------------------------------
# 3. IMAGES & VISUAL MEDIA (FREE OPTIONS)
# ---------------------------------------------------------------------
# OPTION A (RECOMMENDED): Pixabay API
# 5,000 requests/hour (100 req/min) 100% FREE forever!
# Get free key here (Instant on sign up, no credit card): https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# OPTION B: Unsplash Developer API
# 50 requests/hour free forever. High quality photography.
# Get free key here (No credit card required): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# OPTION C: Pexels API (Leave blank if not using)
PEXELS_API_KEY=

# ---------------------------------------------------------------------
# 4. OTHER FREE DEVELOPER & ENTERTAINMENT PROVIDERS (OPTIONAL)
# ---------------------------------------------------------------------
# YouTube Data API v3 (10,000 units/day free from Google Cloud Console)
# If left blank, keyless public video discovery is used automatically.
YOUTUBE_API_KEY=your_youtube_api_key_here

# TMDB (The Movie Database - Free developer key at https://www.themoviedb.org/settings/api)
# If left blank, TVMaze keyless discovery is used automatically.
TMDB_API_KEY=your_tmdb_api_key_here

# Hugging Face Free User Token (https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ---------------------------------------------------------------------
# 5. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Local SQLite: sqlite:///./recomind.db
# Production PostgreSQL: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=sqlite:///./recomind.db

# ---------------------------------------------------------------------
# 6. LOCAL SERVER & CORS CONFIGURATION
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
PORT=8000
